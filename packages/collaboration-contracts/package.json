{
  "name": "@planweave-ai/collaboration-contracts",
  "version": "0.3.0",
  "description": "Schema-only public wire contracts for PlanWeave human collaboration (Desktop ↔ Server).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "homepage": "https://github.com/GaosCode/PlanWeave#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaosCode/PlanWeave.git",
    "directory": "packages/collaboration-contracts"
  },
  "bugs": {
    "url": "https://github.com/GaosCode/PlanWeave/issues"
  },
  "keywords": [
    "planweave",
    "collaboration",
    "contracts",
    "schema"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "test": "cd ../.. && vitest run packages/collaboration-contracts/src"
  },
  "dependencies": {
    "@planweave-ai/distributed-protocol": "workspace:*",
    "zod": "^4.1.12"
  }
}
